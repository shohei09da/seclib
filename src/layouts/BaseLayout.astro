---
// src/layouts/BaseLayout.astro
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | seclib.net</title>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
        <a href="/" class="text-xl font-bold tracking-tight text-slate-900">
          seclib<span class="text-sky-600">.net</span>
        </a>
        <nav class="flex gap-4 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-sky-600">トップ</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-8">
      <slot />
    </main>

    <script>
      async function renderMermaid() {
        const targets = document.querySelectorAll<HTMLElement>(
          'pre.mermaid, pre > code.language-mermaid, pre[data-language="mermaid"] > code'
        );
        if (targets.length === 0) return;

        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({
          startOnLoad: false,
          theme: 'neutral',
          securityLevel: 'strict',
        });

        let index = 0;
        for (const el of targets) {
          const pre = el.tagName === 'PRE' ? el : el.parentElement;
          if (!pre || pre.dataset.mermaidProcessed) continue;
          pre.dataset.mermaidProcessed = 'true';

          const graphDefinition = (el.textContent ?? '').trim();
          if (!graphDefinition) continue;

          try {
            const { svg } = await mermaid.render(`mermaid-graph-${index++}`, graphDefinition);
            const wrapper = document.createElement('div');
            wrapper.className = 'mermaid';
            wrapper.innerHTML = svg;
            pre.replaceWith(wrapper);
          } catch (err) {
            console.error('Mermaid render error:', err);
          }
        }
      }

      renderMermaid();
      document.addEventListener('astro:page-load', renderMermaid);
    </script>
  </body>
</html>