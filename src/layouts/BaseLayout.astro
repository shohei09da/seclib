---
// src/layouts/BaseLayout.astro
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | seclib.net</title>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
        <a href="/" class="text-xl font-bold tracking-tight text-slate-900">
          seclib<span class="text-sky-600">.net</span>
        </a>
        <nav class="flex gap-4 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-sky-600">トップ</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>